datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  DISABLED
}

model Organization {
  id                  String                  @id @default(uuid())
  name                String                  @unique
  code                String                  @unique
  status              OrganizationStatus      @default(ACTIVE)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  users               User[]
  applicationAccesses UserApplicationAccess[]
  applications        OrganizationApplication[]
}

model User {
  id                  String                  @id @default(uuid())
  name                String
  email               String                  @unique
  passwordHash        String
  status              UserStatus              @default(ACTIVE)
  organizationId      String
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  sessions            Session[]
  auditLogs           AuditLog[]
  applicationAccesses UserApplicationAccess[]
  launchCodes         ApplicationLaunchCode[]

  @@index([status])
  @@index([organizationId])
}

enum ApplicationStatus {
  ACTIVE
  DISABLED
}

model Application {
  id                  String                  @id @default(uuid())
  code                String                  @unique // e.g. "PLATFORM", "TICKETING", "CONCESSION"
  name                String
  description         String?
  status              ApplicationStatus       @default(ACTIVE)
  launchEnabled       Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  roles               Role[]
  permissions         Permission[]
  applicationAccesses UserApplicationAccess[]
  organizations       OrganizationApplication[]

  @@index([status])
}

model Role {
  id                  String                  @id @default(uuid())
  code                String                  @unique // e.g. "PLATFORM_ADMINISTRATOR", "TICKETING_CASHIER"
  name                String
  applicationCode     String
  application         Application             @relation(fields: [applicationCode], references: [code], onDelete: Cascade)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  rolePermissions     RolePermission[]
  applicationAccesses UserApplicationAccess[]

  @@index([applicationCode])
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique // e.g. "platform.users.view"
  name            String
  applicationCode String
  application     Application      @relation(fields: [applicationCode], references: [code], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([applicationCode])
}

model UserApplicationAccess {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationCode String
  application     Application  @relation(fields: [applicationCode], references: [code], onDelete: Cascade)
  roleId          String
  role            Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, applicationCode])
  @@index([organizationId])
  @@index([userId])
  @@index([applicationCode])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Session {
  id         String   @id // Stores the HASHED session token
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. "LOGIN", "USER_CREATED"
  entity    String   // e.g. "User", "Role"
  entityId  String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AppSetting {
  id          String   @id @default(uuid())
  key         String
  value       String
  valueType   String   @default("STRING") // STRING, INTEGER, BOOLEAN, DECIMAL, JSON
  category    String   @default("GENERAL") // GENERAL, SECURITY, SESSION, APPLICATION, FEATURE, GOVERNANCE
  scope       String   @default("GLOBAL") // GLOBAL, APPLICATION, ORGANIZATION
  scopeId     String   @default("")
  description String?
  isSensitive Boolean  @default(false)
  isEditable  Boolean  @default(true)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, scope, scopeId])
}

model ApplicationLaunchCode {
  id              String    @id @default(uuid())
  codeHash        String    @unique
  userId          String
  applicationCode String
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationCode])
  @@index([expiresAt])
}

model OrganizationApplication {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String
  application    Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status         ApplicationStatus @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, applicationId])
  @@index([organizationId])
  @@index([applicationId])
}

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model ExecutiveAlert {
  id              String        @id @default(uuid())
  fingerprint     String
  severity        AlertSeverity
  category        String
  title           String
  description     String
  source          String
  applicationCode String?
  status          AlertStatus   @default(OPEN)
  detectedAt      DateTime      @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([fingerprint])
  @@index([status])
  @@index([severity])
  @@index([category])
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  CAPTURE
  DENY
  CANCEL
  EXPIRE
  FAILURE
  REFUND
}

enum PaymentProvider {
  MIDTRANS
  MANUAL
}

model PaymentTransaction {
  id                    String              @id @default(uuid())
  transactionNumber     String              @unique // Master Transaction Number (e.g. TRX-20260928-XXXX)
  appCode               String              // "TICKETING", "CONCESSION", "PARKING", "COMBO"
  externalOrderId       String              // Order ID pada sistem asal (e.g. ORD-TCK-001)
  provider              PaymentProvider     @default(MIDTRANS)
  paymentType           String              @default("qris") // qris, snap, gopay, bank_transfer
  grossAmount           Float
  currency              String              @default("IDR")
  status                PaymentStatus       @default(PENDING)
  midtransTransactionId String?             @unique
  snapToken             String?
  redirectUrl           String?             // QR code image URL atau payment URL
  qrString              String?             // Raw QR string untuk render lokal
  customerName          String?
  customerEmail         String?
  customerPhone         String?
  itemDetails           Json?               // Snapshot item yang dibeli
  metadata              Json?               // Informasi tambahan / context
  rawResponse           Json?               // Respons lengkap dari Midtrans
  expiredAt             DateTime?
  settledAt             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  splitItems            PaymentSplitItem[]
  webhookLogs           PaymentWebhookLog[]

  @@index([appCode])
  @@index([externalOrderId])
  @@index([status])
  @@index([createdAt])
}

model PaymentSplitItem {
  id                    String             @id @default(uuid())
  paymentTransactionId  String
  targetAppCode         String             // TICKETING, CONCESSION, PARKING
  targetOrderId         String             // ID sub-order spesifik di microservice target
  amount                Float
  status                PaymentStatus      @default(PENDING)
  dispatchedAt          DateTime?
  acknowledgedAt        DateTime?
  dispatchResponse      Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  paymentTransaction    PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)

  @@index([paymentTransactionId])
  @@index([targetAppCode, targetOrderId])
}

model PaymentWebhookLog {
  id                    String              @id @default(uuid())
  paymentTransactionId  String?
  provider              String              @default("MIDTRANS")
  orderId               String              // order_id dari payload webhook
  statusCode            String?
  grossAmount           String?
  signatureKey          String?
  isSignatureValid      Boolean
  eventStatus           String              // transaction_status dari payload
  payload               Json
  dispatchStatus        String              // SUCCESS, FAILED, RETRYING, SKIPPED
  dispatchError         String?
  createdAt             DateTime            @default(now())

  paymentTransaction    PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([isSignatureValid])
  @@index([createdAt])
}

