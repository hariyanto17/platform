datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  DISABLED
}

model Organization {
  id                  String                    @id @default(uuid())
  name                String                    @unique
  code                String                    @unique
  status              OrganizationStatus        @default(ACTIVE)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  users               User[]
  applicationAccesses UserApplicationAccess[]
  applications        OrganizationApplication[]
}

model User {
  id                  String                  @id @default(uuid())
  name                String
  email               String                  @unique
  passwordHash        String
  status              UserStatus              @default(ACTIVE)
  organizationId      String
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  sessions            Session[]
  auditLogs           AuditLog[]
  applicationAccesses UserApplicationAccess[]
  launchCodes         ApplicationLaunchCode[]

  @@index([status])
  @@index([organizationId])
}

enum ApplicationStatus {
  ACTIVE
  DISABLED
}

model Application {
  id                  String                    @id @default(uuid())
  code                String                    @unique // e.g. "PLATFORM", "TICKETING", "CONCESSION"
  name                String
  description         String?
  status              ApplicationStatus         @default(ACTIVE)
  launchEnabled       Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  roles               Role[]
  permissions         Permission[]
  applicationAccesses UserApplicationAccess[]
  organizations       OrganizationApplication[]

  @@index([status])
}

model Role {
  id                  String                  @id @default(uuid())
  code                String                  @unique // e.g. "PLATFORM_ADMINISTRATOR", "TICKETING_CASHIER"
  name                String
  applicationCode     String
  application         Application             @relation(fields: [applicationCode], references: [code], onDelete: Cascade)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  rolePermissions     RolePermission[]
  applicationAccesses UserApplicationAccess[]

  @@index([applicationCode])
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique // e.g. "platform.users.view"
  name            String
  applicationCode String
  application     Application      @relation(fields: [applicationCode], references: [code], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([applicationCode])
}

model UserApplicationAccess {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationCode String
  application     Application  @relation(fields: [applicationCode], references: [code], onDelete: Cascade)
  roleId          String
  role            Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, applicationCode])
  @@index([organizationId])
  @@index([userId])
  @@index([applicationCode])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Session {
  id         String   @id // Stores the HASHED session token
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // e.g. "LOGIN", "USER_CREATED"
  entity    String // e.g. "User", "Role"
  entityId  String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AppSetting {
  id          String   @id @default(uuid())
  key         String
  value       String
  valueType   String   @default("STRING") // STRING, INTEGER, BOOLEAN, DECIMAL, JSON
  category    String   @default("GENERAL") // GENERAL, SECURITY, SESSION, APPLICATION, FEATURE, GOVERNANCE
  scope       String   @default("GLOBAL") // GLOBAL, APPLICATION, ORGANIZATION
  scopeId     String   @default("")
  description String?
  isSensitive Boolean  @default(false)
  isEditable  Boolean  @default(true)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, scope, scopeId])
}

model ApplicationLaunchCode {
  id              String    @id @default(uuid())
  codeHash        String    @unique
  userId          String
  applicationCode String
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationCode])
  @@index([expiresAt])
}

model OrganizationApplication {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String
  application    Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status         ApplicationStatus @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, applicationId])
  @@index([organizationId])
  @@index([applicationId])
}

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model ExecutiveAlert {
  id              String        @id @default(uuid())
  fingerprint     String
  severity        AlertSeverity
  category        String
  title           String
  description     String
  source          String
  applicationCode String?
  status          AlertStatus   @default(OPEN)
  detectedAt      DateTime      @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([fingerprint])
  @@index([status])
  @@index([severity])
  @@index([category])
}

// ============================================================================
// PHASE 8A.1: PRODUCT CATALOG DOMAIN
// ============================================================================

model Module {
  id          String    @id @default(uuid())
  code        String    @unique // e.g. "pos", "inventory", "crm", "report", "cinema", "fnb", "parking"
  name        String
  description String?
  isShared    Boolean   @default(true)
  status      String    @default("ACTIVE") // ACTIVE, DISABLED
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  features    Feature[]

  @@index([status])
  @@index([code])
}

model Feature {
  id               String              @id @default(uuid())
  key              String              @unique // canonical: e.g. "pos.checkout.cash"
  name             String
  description      String?
  moduleCode       String
  module           Module              @relation(fields: [moduleCode], references: [code], onDelete: Cascade)
  isCore           Boolean             @default(false)
  status           String              @default("ACTIVE") // ACTIVE, DISABLED
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  planFeatures     PlanFeature[]
  addOnFeatures    AddOnFeature[]
  verticalFeatures VerticalFeature[]
  dependencies     FeatureDependency[] @relation("FeatureAsDependent")
  requiredBy       FeatureDependency[] @relation("FeatureAsRequired")

  @@index([moduleCode])
  @@index([key])
  @@index([status])
}

model FeatureDependency {
  id             String   @id @default(uuid())
  featureKey     String
  dependsOnKey   String
  dependencyType String   @default("REQUIRED") // REQUIRED, OPTIONAL, RECOMMENDED
  createdAt      DateTime @default(now())
  feature        Feature  @relation("FeatureAsDependent", fields: [featureKey], references: [key], onDelete: Cascade)
  dependsOn      Feature  @relation("FeatureAsRequired", fields: [dependsOnKey], references: [key], onDelete: Cascade)

  @@unique([featureKey, dependsOnKey])
  @@index([featureKey])
  @@index([dependsOnKey])
}

model Plan {
  id           String        @id @default(uuid())
  code         String        @unique // e.g. "PLAN_FREE", "PLAN_STARTER", "PLAN_PRO", "PLAN_BUSINESS", "PLAN_ENTERPRISE"
  name         String
  tier         String // FREE, STARTER, PRO, BUSINESS, ENTERPRISE
  description  String?
  status       String        @default("ACTIVE") // ACTIVE, DISABLED, ARCHIVED
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  planFeatures PlanFeature[]

  @@index([code])
  @@index([tier])
  @@index([status])
}

model PlanFeature {
  id         String   @id @default(uuid())
  planCode   String
  featureKey String
  createdAt  DateTime @default(now())
  plan       Plan     @relation(fields: [planCode], references: [code], onDelete: Cascade)
  feature    Feature  @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([planCode, featureKey])
  @@index([planCode])
  @@index([featureKey])
}

model AddOn {
  id            String         @id @default(uuid())
  code          String         @unique // e.g. "ADDON_KDS", "ADDON_SELF_ORDER", "ADDON_LOYALTY", "ADDON_ADV_WMS", "ADDON_OPEN_API", "ADDON_WHATSAPP"
  name          String
  description   String?
  status        String         @default("ACTIVE") // ACTIVE, DISABLED, ARCHIVED
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  addOnFeatures AddOnFeature[]

  @@index([code])
  @@index([status])
}

model AddOnFeature {
  id         String   @id @default(uuid())
  addOnCode  String
  featureKey String
  createdAt  DateTime @default(now())
  addOn      AddOn    @relation(fields: [addOnCode], references: [code], onDelete: Cascade)
  feature    Feature  @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([addOnCode, featureKey])
  @@index([addOnCode])
  @@index([featureKey])
}

model Vertical {
  id               String            @id @default(uuid())
  code             String            @unique // e.g. "VERTICAL_CINEMA", "VERTICAL_FNB", "VERTICAL_PARKING", "VERTICAL_RETAIL", "VERTICAL_BILLIARD", "VERTICAL_SERVICE"
  name             String
  description      String?
  status           String            @default("ACTIVE") // ACTIVE, DISABLED, ARCHIVED
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  verticalFeatures VerticalFeature[]

  @@index([code])
  @@index([status])
}

model VerticalFeature {
  id           String   @id @default(uuid())
  verticalCode String
  featureKey   String
  createdAt    DateTime @default(now())
  vertical     Vertical @relation(fields: [verticalCode], references: [code], onDelete: Cascade)
  feature      Feature  @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([verticalCode, featureKey])
  @@index([verticalCode])
  @@index([featureKey])
}
